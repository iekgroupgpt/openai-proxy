# Базовый URL OpenAI API
OPENAI_BASE_URL=https://api.openai.com

# Прокси для исходящих запросов к OpenAI
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Таймауты httpx (сек)
REQUEST_TIMEOUT_CONNECT=10      
REQUEST_TIMEOUT_READ=300
REQUEST_TIMEOUT_WRITE=30
REQUEST_TIMEOUT_POOL=10

# Повторные попытки
MAX_RETRIES=1
RETRY_BACKOFF_BASE=0.4
RETRY_IDEMPOTENT_ONLY=true

# Логирование
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# HTTP server
HOST=0.0.0.0
PORT=8000

# Служебная версия (для логов/диагностики)
APP_VERSION=0.1.2
